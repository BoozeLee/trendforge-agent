# Solana RPC — get free tier at https://synapse.oobeprotocol.ai/
SYNAPSE_RPC_URL=https://us-1-mainnet.oobeprotocol.ai/rpc?api_key=sk_YOUR_KEY_HERE

# Ace Data Cloud API base (default is fine)
ACE_API_BASE=https://api.acedata.cloud

# Path to your Solana keypair JSON (64-byte array)
SOLANA_KEYPAIR_PATH=keys/agent.json

# USDC mint on Solana mainnet (default correct)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# How often the agent loops (seconds). 3600 = 1 hour
WORKFLOW_INTERVAL_SECS=3600

# Topic the agent researches autonomously
SEARCH_QUERY=AI agent autonomous Solana blockchain 2026
